# Copy this file to .env for docker-compose local development.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL (docker-compose) ---
# The defaults below match the ConnectionStrings:AuditVitals value already
# committed in src/AuditVitals.Api/appsettings.Development.json and
# src/AuditVitals.Worker/appsettings.Development.json. If you change any of
# these, update those two files (or override ConnectionStrings__AuditVitals
# as an environment variable) to match.
POSTGRES_DB=auditvitals
POSTGRES_USER=auditvitals
POSTGRES_PASSWORD=auditvitals_dev_password
POSTGRES_PORT=5432

# --- ASP.NET Core (Api / Worker) ---
# Only needed outside Development (Development reads appsettings.Development.json
# instead). Double underscores map to nested configuration sections.
# ConnectionStrings__AuditVitals=Host=localhost;Port=5432;Database=auditvitals;Username=auditvitals;Password=CHANGE_ME
